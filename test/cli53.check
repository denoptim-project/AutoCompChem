#!/bin/bash

function not_passed() {
  echo "NOT Passed: check condition leading to line '$1' of '$0'"
  exit -1
}

if [ ! -f "cli53_results.trj" ] ; then not_passed $LINENO ; fi

n=0; n=$(grep -c -i ">" "cli53_results.trj")
if [ 11 != "$n" ] ; then not_passed $LINENO ; fi

n=0; n=$(grep -c -i "^C " "cli53_results.trj")
if [ 11 != "$n" ] ; then not_passed $LINENO ; fi

n=0; n=$(grep -c -i "O " "cli53_results.trj")
if [ 11 != "$n" ] ; then not_passed $LINENO ; fi

expected=$(grep "C " ../cli53_a.xyz ../cli53_b.sdf ../cli53_c.xyz ../cli53_d.sdf | sed 's/ *//g' | sed 's/C//g' | cut -c 16-20)
actual=$(grep "C " cli53_results.trj | sed 's/ *//g' | sed 's/C//g' | cut -c 1-5)

if [ "$expected" != "$actual" ] ; then not_passed $LINENO ; fi
if [ ! -f "cli53.log" ] ; then not_passed $LINENO ; fi

n=0; n=$(grep -c -i "Termination status: 0" "cli53.log")
if [ 1 == "$n" ] ; then echo Passed ; exit 0 ; fi
not_passed $LINENO
exit -1
