#!/bin/bash

function not_passed() {
  echo "NOT Passed: check condition leading to line '$1' of '$0'"
  exit -1
}

if [ ! -f "t169-mol.xcontrol" ] ; then not_passed $LINENO ; fi

n=0;n=$(grep -c "^ *\$ffnb" t169-mol.xcontrol)
if [ 1 != "$n" ] ; then not_passed $LINENO ; fi

n=0;n=$(grep -c "^ *nb =" t169-mol.xcontrol)
if [ 1250 != "$n" ] ; then not_passed $LINENO ; fi

n=0;n=$(grep -c "^ *distance: " t169-mol.xcontrol)
if [ 12 != "$n" ] ; then not_passed $LINENO ; fi

n=0;n=$(grep -c "^ *angle: " t169-mol.xcontrol)
if [ 30 != "$n" ] ; then not_passed $LINENO ; fi

if grep -q 'Termination status: 0' "t169.log" ; then echo Passed ; exit 0 ; fi
not_passed $LINENO
exit -1
