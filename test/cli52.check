#!/bin/bash

function not_passed() {
  echo "NOT Passed: check condition leading to line '$1' of '$0'"
  exit -1
}

if [ ! -f "cli52_results.sdf" ] ; then not_passed $LINENO ; fi

n=0; n=$(grep -c -i "\$\$\$\$" "cli52_results.sdf")
if [ 4 != "$n" ] ; then not_passed $LINENO ; fi

n=0; n=$(grep -c -i "mol_" "cli52_results.sdf")
if [ 4 != "$n" ] ; then not_passed $LINENO ; fi

if [ "$(grep -i "mol_" "cli52_results.sdf" | sed 's/mol_//' | tr -d '\n')" != "DCBA" ] ; then not_passed $LINENO ; fi

if [ ! -f "cli52_results.xyz" ] ; then not_passed $LINENO ; fi

n=0; n=$(grep -c -i "^2$" "cli52_results.xyz")
if [ 4 != "$n" ] ; then not_passed $LINENO ; fi

n=0; n=$(grep -c -i "mol_" "cli52_results.xyz")
if [ 4 != "$n" ] ; then not_passed $LINENO ; fi

if [ "$(grep -i "mol_" "cli52_results.xyz" | sed 's/mol_//' | tr -d '\n')" != "DCBA" ] ; then not_passed $LINENO ; fi

if [ ! -f "cli52.log" ] ; then not_passed $LINENO ; fi

n=0; n=$(grep -c -i "Termination status: 0" "cli52.log")
if [ 1 == "$n" ] ; then echo Passed ; exit 0 ; fi
not_passed $LINENO
exit -1
